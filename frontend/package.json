{
     "name": "securescript",
     "version": "1.0.0",
     "description": "SecureScript - Windows Security Policy Management Tool",
     "author": "SecureScript Team",
     "main": "main.js",
     "private": true,
     "homepage": "./",
     "dependencies": {
          "@testing-library/jest-dom": "^5.17.0",
          "@testing-library/react": "^13.4.0",
          "@testing-library/user-event": "^13.5.0",
          "@types/jest": "^27.5.2",
          "@types/node": "^16.18.97",
          "@types/react": "^18.3.2",
          "@types/react-dom": "^18.3.0",
          "axios": "^1.7.2",
          "electron-is-dev": "^3.0.1",
          "react": "^18.3.1",
          "react-dom": "^18.3.1",
          "react-router-dom": "^6.23.1",
          "react-scripts": "5.0.1",
          "typescript": "^4.9.5",
          "web-vitals": "^2.1.4"
     },
     "devDependencies": {
          "autoprefixer": "^10.4.19",
          "concurrently": "^9.2.1",
          "electron": "^37.2.5",
          "electron-builder": "^26.4.0",
          "electron-packager": "^17.1.2",
          "icon-gen": "^5.0.0",
          "png-to-ico": "^3.0.1",
          "png2icons": "^2.0.1",
          "postcss": "^8.4.38",
          "rcedit": "^5.0.2",
          "sharp": "^0.34.5",
          "tailwindcss": "^3.4.3",
          "wait-on": "^8.0.1"
     },
     "scripts": {
          "start": "react-scripts start",
          "build": "react-scripts build",
          "test": "react-scripts test",
          "eject": "react-scripts eject",
          "electron": "electron .",
          "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
          "generate-icons": "node generate-icons.js",
          "package": "npm run build && electron-builder",
          "package:win": "npm run build && electron-builder --win",
          "package:win:simple": "electron-packager . SecureScript --platform=win32 --arch=x64 --icon=build-resources/icon.png --out=dist --overwrite --asar",
          "package:mac": "npm run build && electron-builder --mac",
          "package:linux": "npm run build && electron-builder --linux"
     },
     "build": {
          "appId": "com.securescript.app",
          "productName": "SecureScript",
          "files": [
               "build/**/*",
               "build-resources/**/*",
               "main.js",
               "preload.js"
          ],
          "directories": {
               "buildResources": "build-resources",
               "output": "release"
          },
          "win": {
               "target": [
                    {
                         "target": "portable",
                         "arch": [
                              "x64"
                         ]
                    }
               ],
               "icon": "build-resources/icon.ico",
               "artifactName": "${productName}-${version}-Portable.${ext}"
          },
          "portable": {
               "artifactName": "${productName}-${version}-Portable.${ext}"
          },
          "mac": {
               "target": "dmg",
               "icon": "build-resources/icon.png"
          },
          "linux": {
               "target": "AppImage",
               "icon": "build-resources/icon.png",
               "category": "Security"
          }
     },
     "browserslist": {
          "production": [
               "electron 37.2"
          ],
          "development": [
               "last 1 electron version"
          ]
     }
}
